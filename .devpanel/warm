#!/usr/bin/env php
<?php

/**
 * @file
 * Warms the Drupal page cache for one path, without needing a running webserver.
 *
 * Bootstraps index.php with a synthetic request and throws the output away, so the
 * published image ships with warm caches and the first real visitor does not pay
 * for a cold container.
 *
 * Usage: .devpanel/warm [path]   (defaults to /)
 */

chdir(dirname(__DIR__) . '/web');
$_SERVER['HTTP_USER_AGENT'] = 'Atelier demo cache warmer';
$_SERVER['REQUEST_URI'] = $argv[1] ?? '/';
$_SERVER['REQUEST_METHOD'] = 'GET';
$_SERVER['SCRIPT_NAME'] = '/index.php';
$_SERVER['SCRIPT_FILENAME'] = getcwd() . '/index.php';
$_SERVER['SERVER_NAME'] = 'localhost';
$_SERVER['SERVER_PORT'] = '80';
ob_start(fn($buffer, $phase) => TRUE, 1);
require 'index.php';
ob_end_clean();
echo 'Warmed cache for ' . $_SERVER['REQUEST_URI'] . "\n";
